# Copy to .env and fill in ONE provider key. Never commit the real .env — Rule R7.
#
# The system auto-detects the provider from whichever key is present.
# Priority if several are set: Anthropic > OpenAI > Gemini > Groq. Override with TRIAGE_PROVIDER.
# No key at all -> deterministic FakeLLM (one-line warning); the project stays fully offline-runnable.
#
# Non-Anthropic providers need:  pip install -e ".[providers]"

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- optional ---
# TRIAGE_PROVIDER=            # anthropic | openai | gemini | groq  (overrides auto-detect)
TRIAGE_MODEL=                # blank = provider default:
                             #   anthropic  claude-opus-5
                             #   openai     gpt-4o-mini
                             #   gemini     gemini-2.0-flash
                             #   groq       llama-3.3-70b-versatile
# TRIAGE_TEMPERATURE=0       # blank = let the model default (needed for some reasoning models)
TRIAGE_MAX_TOKENS=16000
TRIAGE_EFFORT=low            # Anthropic-only (extended-thinking effort); ignored by other providers
TRIAGE_MAX_ITERATIONS=6
TRIAGE_LOOKBACK_DAYS=90

# Note: if you set TRIAGE_MODEL to a concrete id, clear it (or change it) when you switch
# providers — otherwise that id is sent to the new provider and the request fails.
